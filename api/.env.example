# 複製此檔為 .env，填入自己的 Gemini API key；不要把 .env 提交到 Git。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# 若使用相容的企業閘道，可取消下一行註解並修改：
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# AES-128 AI-CNN / AI-MLP server benchmark assets
# Leave blank to use api/ai_assets/data and api/ai_assets/models.
SCA_AI_DATA_PATH=
SCA_AI_MODEL_PATH=
# 0 means all attack traces; set e.g. 2000 to shorten classroom demos.
SCA_AI_MAX_TRACES=0
